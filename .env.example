# ============================================================
# NOTES Platform — Environment Variables Template
# Copy this to .env in each sub-project and fill in values
# ============================================================

# ── Backend ─────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/notes_db
PORT=3001
CORS_ORIGIN=http://localhost:3000

# Pinata IPFS (get free keys at https://app.pinata.cloud)
PINATA_API_KEY=
PINATA_SECRET_API_KEY=
PINATA_GATEWAY=https://gateway.pinata.cloud/ipfs/

# Blockchain (Polygon Amoy testnet)
RPC_URL=https://rpc-amoy.polygon.technology
PRIVATE_KEY=          # wallet private key (never commit!)
CONTRACT_ADDRESS=     # set after deploying the contract

# ── Contracts ───────────────────────────────────────────────
POLYGON_AMOY_RPC_URL=https://rpc-amoy.polygon.technology
DEPLOYER_PRIVATE_KEY=

# ── Frontend ────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_CONTRACT_ADDRESS=
NEXT_PUBLIC_RAINBOWKIT_PROJECT_ID=   # from https://cloud.walletconnect.com
NEXT_PUBLIC_CHAIN_ID=80002           # Polygon Amoy
